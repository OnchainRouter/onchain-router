{
  "name": "@agenticfi/onchain-router-buyer-core",
  "version": "0.1.0",
  "private": false,
  "description": "Secure local wallet, budget, x402 payment, recovery, and receipt runtime for Onchain Router",
  "license": "MIT",
  "author": "AgenticFI",
  "keywords": [
    "x402",
    "usdc",
    "base",
    "ai-agents",
    "wallet",
    "payments",
    "budgets"
  ],
  "homepage": "https://llm.agenticfi.wtf/docs/buyer-runtime",
  "bugs": "https://github.com/AgenticFI/onchain-router-clients/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgenticFI/onchain-router-clients.git",
    "directory": "packages/buyer-core"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "buyer-core-threat-model.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/admin.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "better-sqlite3": "12.11.1",
    "ethers": "6.17.0",
    "viem": "2.55.11",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "version": "onchain-router-routing-benchmark/v1",
  "name": "gemini-private-held-out-v1",
  "baselineModel": "gemini-3.1-flash-lite",
  "minimumAggregateQualityGainBasisPoints": 250,
  "modelPriors": [
    {
      "id": "gemini-3.6-flash",
      "qualityBasisPoints": {
        "general": 9000,
        "code": 9000,

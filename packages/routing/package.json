{
  "name": "@onchainrouter/routing",
  "version": "0.2.0",
  "private": false,
  "description": "Experimental deterministic model-selection core for Onchain Router",
  "license": "MIT",
  "author": "Onchain Router contributors",
  "keywords": [
    "llm",
    "routing",
    "model-router",
    "ai-agents",
    "x402",
    "cost",
    "latency"
  ],
  "homepage": "https://onchainrouter.dev/docs/routing",
  "bugs": "https://github.com/OnchainRouter/onchain-router/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnchainRouter/onchain-router.git",
    "directory": "packages/routing"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "UPSTREAM.md",
    "routing-threat-model.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

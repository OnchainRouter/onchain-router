{
  "name": "@agenticfi/onchain-router",
  "version": "0.1.3",
  "private": false,
  "description": "TypeScript SDK for Onchain Router discovery, x402 payments, recovery, and receipts",
  "license": "MIT",
  "author": "AgenticFI",
  "keywords": [
    "x402",
    "usdc",
    "base",
    "ai",
    "agents",
    "llm",
    "sdk"
  ],
  "homepage": "https://onchainrouter.dev/docs/sdk",
  "bugs": "https://github.com/AgenticFI/onchain-router-clients/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgenticFI/onchain-router-clients.git",
    "directory": "clients/typescript"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/admin.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agenticfi/onchain-router-buyer-core": "workspace:*",
    "@agenticfi/onchain-router-routing": "workspace:*",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/fetch": "2.21.0",
    "viem": "2.55.11"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
